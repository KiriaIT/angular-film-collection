## ══════════════════════════════════════════
## 7. SERVICES
## ══════════════════════════════════════════

### FilmService:
```typescript
// src/app/core/services/film.service.ts
import { Injectable, computed, signal } from '@angular/core';
import { Film } from '../../models/film.model';
import { FILMS_MOCK } from '../../data/films.mock';

@Injectable({ providedIn: 'root' })
export class FilmService {
  private readonly _films = signal<Film[]>(FILMS_MOCK);

  readonly films    = this._films.asReadonly();
  readonly favorites = computed(() => this._films().filter(f => f.isFavorite));

  getById(id: number): Film | undefined {
    return this._films().find(f => f.id === id);
  }

  toggleFavorite(id: number): void {
    this._films.update(list =>
      list.map(f => f.id === id ? { ...f, isFavorite: !f.isFavorite } : f)
    );
  }
}
```

### BreadcrumbService — signals-only, no RxJS:
```typescript
// src/app/core/services/breadcrumb.service.ts
import { Injectable, signal } from '@angular/core';
import { Breadcrumb } from '../../models/breadcrumb.model';

@Injectable({ providedIn: 'root' })
export class BreadcrumbService {
  private readonly _crumbs = signal<Breadcrumb[]>([]);
  readonly crumbs = this._crumbs.asReadonly();

  set(crumbs: Breadcrumb[]): void {
    this._crumbs.set(crumbs);
  }
}
```

**Service rules:**
- Always `providedIn: 'root'` — never provide in a component or feature
- Private signal + `asReadonly()` for public exposure — enforces unidirectional flow
- No constructor logic — initialize at field declaration
- Methods are actions: update state and return `void`
- No `async` methods (no HTTP in this project)

